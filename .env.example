# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/catalog_manager"

# Dutchie API base URL
DUTCHIE_BASE_URL="https://api.dutchie.com"

# Dutchie API auth tokens (one per dispensary location)
DUTCHIE_AUTH_BILLINGS="your-auth-token-here"
DUTCHIE_AUTH_BOZEMAN="your-auth-token-here"
DUTCHIE_AUTH_BUTTE="your-auth-token-here"
DUTCHIE_AUTH_FOUR_CORNERS="your-auth-token-here"
DUTCHIE_AUTH_GREAT_FALLS="your-auth-token-here"
DUTCHIE_AUTH_HELENA="your-auth-token-here"
DUTCHIE_AUTH_KALISPELL="your-auth-token-here"
DUTCHIE_AUTH_MISSOULA="your-auth-token-here"
DUTCHIE_AUTH_EMIGRANT="your-auth-token-here"
DUTCHIE_AUTH_BIRDSEYE="your-auth-token-here"
DUTCHIE_AUTH_MANUFACTURING="your-auth-token-here"

# OpenAI API key (used for AI-generated product descriptions)
OPENAI_API_KEY="sk-your-openai-api-key-here"
